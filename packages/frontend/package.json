{
  "name": "@gwj/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && bun run build:worker",
    "build:worker": "bun build src/worker/index.ts --target=browser --format=esm --minify --outfile=dist/_worker.js",
    "preview": "vite preview",
    "typecheck": "bun check",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@gwj/shared-types": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "4.14.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^5.0.3"
  }
}
