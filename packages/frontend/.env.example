# Frontend build-time config (Vite). Copy to .env.production for local builds.
# VITE_-prefixed vars are PUBLIC (baked into the client bundle) — never put
# secrets here. Without this the SPA falls back to a relative /api path and
# receives the SPA HTML shell instead of JSON. CI sets this via the
# `VITE_API_BASE_URL` Actions variable (with a built-in default in the workflow).
VITE_API_BASE_URL=https://api.globalworldjournal.com
