# Long-lived immutable cache for content-hashed build assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static brand assets — cache a day.
/favicon.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/logo-icon.svg
  Cache-Control: public, max-age=86400
