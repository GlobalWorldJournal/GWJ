{
  "name": "@gwj/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "bun check",
    "test": "bun test --isolate --timeout=60000",
    "seed": "bun run src/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@gwj/shared-types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cors": "^2.8.5",
    "drizzle-orm": "0.45.2",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "postgres": "3.4.9",
    "sharp": "^0.35.2",
    "stripe": "^23.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "0.31.10",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3"
  }
}
