{
  "name": "@gwj/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "bun check",
    "test": "bun test --isolate --timeout=60000",
    "seed": "bun run src/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/client-sesv2": "^3.1149.0",
    "@gwj/shared-types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.5",
    "drizzle-orm": "0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "postgres": "3.4.9",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "^7.3.1",
    "typescript": "^5.6.3"
  }
}
