# ─── Backend (@gwj/backend) ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# MongoDB Atlas connection string (own cluster, NOT Oxy)
MONGO_URI=
# JWT signing secret for admin auth (long random string)
JWT_SECRET=
# Admin user seeded on `bun run seed` — password is bcrypt-hashed, never stored plaintext
ADMIN_USERNAME=nate
ADMIN_PASSWORD=
# Comma-separated allowed CORS origins (frontend + admin)
CORS_ORIGINS=http://localhost:5173,https://globalworldjournal.com

# ─── Media / S3 + CloudFront ──────────────────────────────────────────────
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are OPTIONAL.
# In production (ECS Fargate) leave them UNSET — the SDK uses the IAM task role
# via the default credential provider chain. Set them only for local dev.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=gwj-media
CDN_BASE_URL=https://cdn.globalworldjournal.com

# ─── Distribution channels ────────────────────────────────────────────────
# Telegram channel publisher. OPTIONAL: leave TELEGRAM_BOT_TOKEN unset/blank and
# the Telegram channel is disabled (the backend boots fine; only Mastodon fans out).
# Set it to enable posting to @GWJOfficial (English edition). The bot must be an
# admin of the channel with post rights.
TELEGRAM_BOT_TOKEN=
# Target chat for posts; defaults to @GWJOfficial. Override for a different channel
# or a numeric chat id.
TELEGRAM_CHANNEL=@GWJOfficial

# ─── MCP server (@gwj/mcp) ────────────────────────────────────────────────
MCP_PORT=4100
# Bearer token agents must send to use the MCP server (long random string)
MCP_TOKEN=
# Backend the MCP server talks to
API_BASE_URL=http://localhost:4000

# ─── Frontend (@gwj/frontend) — Vite needs the VITE_ prefix ───────────────
VITE_API_BASE_URL=http://localhost:4000
