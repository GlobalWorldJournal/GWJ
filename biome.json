{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "packages/*/src/**",
      "packages/frontend/public/_worker.js",
      "scripts/**/*.ts",
      "!**/node_modules",
      "!**/dist"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noVar": "error",
        "noTsIgnore": "error",
        "noEmptyBlockStatements": "error",
        "noDebugger": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        }
      }
    }
  }
}
